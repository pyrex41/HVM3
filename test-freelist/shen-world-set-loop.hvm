data A { #Tail{v} #Bind{k v next} }
data W { #World{globals} }
data R { #Ok{value world} }
@build(n tail) = ~n !tail {
  0: tail
  1+p: @build(p #Bind{1 2 tail})
}
@replace(xs val) = ~xs !val {
  #Tail{old}: #Tail{val}
  #Bind{k v next}: #Bind{k v @replace(next val)}
}
@set(world val) = ~world !val {
  #World{globals}: !&0{result stored}=val
                   #Ok{result #World{@replace(globals stored)}}
}
@value(world) = ~world {
  #World{globals}: @tail(globals)
}
@tail(xs) = ~xs {
  #Tail{v}: v
  #Bind{k v next}: @tail(next)
}
@loop(n world) = ~n !world {
  0: @value(world)
  1+p: !&0{count val}=p
       ~@set(world val) {
    #Ok{discard next}: @loop(count next)
  }
}
@main = @loop(5000 #World{@build(50 #Tail{0})})
